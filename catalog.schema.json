{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketing Engineering catalog",
  "type": "object",
  "required": [
    "version",
    "products"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "url",
          "description",
          "category",
          "interfaces",
          "pricing",
          "added"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique, kebab-case."
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Canonical homepage. No tracking params."
          },
          "description": {
            "type": "string",
            "maxLength": 160,
            "description": "One sentence, ends with a period. What it does, not marketing copy."
          },
          "category": {
            "type": "string",
            "description": "Matches a README section heading."
          },
          "interfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "mcp",
                "api",
                "cli",
                "sdk",
                "web",
                "plugin"
              ]
            },
            "description": "How a human or agent uses it."
          },
          "pricing": {
            "enum": [
              "free",
              "freemium",
              "paid",
              "open-source"
            ]
          },
          "docs_url": {
            "type": "string",
            "format": "uri"
          },
          "mcp_url": {
            "type": "string",
            "format": "uri",
            "description": "Remote MCP endpoint, if any."
          },
          "llms_txt": {
            "type": "string",
            "format": "uri",
            "description": "The product's own llms.txt, if any."
          },
          "maker_x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,15}$",
            "description": "Maker's X handle, no @. Used to credit them in the weekly drop."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
